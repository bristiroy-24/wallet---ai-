# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environment ────────────────────────────────────
venv/
.venv/
env/

# ── Environment Variables ──────────────────────────────────
# NEVER commit .env files — they contain secrets (DB passwords, API keys, JWT secrets).
# Copy backend/.env.example → backend/.env and fill in real values locally.
.env
.env.local
.env.production
.env.staging
.env.development
.env.test
**/.env
**/.env.*
!**/.env.example

# ── IDE / Editor ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ── Node (if frontend tooling added later) ─────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Database ───────────────────────────────────────────────
*.db
*.sqlite3

# ── Docker ─────────────────────────────────────────────────
docker-compose.override.yml

# ── Logs ───────────────────────────────────────────────────
*.log
logs/

# ── OS Files ───────────────────────────────────────────────
Thumbs.db
.DS_Store

# ── Coverage / Testing ─────────────────────────────────────
htmlcov/
.coverage
.pytest_cache/
.mypy_cache/