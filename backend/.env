# WalletAI Backend – Environment Variables

# PostgreSQL (your password with special chars needs URL-encoding: @ = %40)
DATABASE_URL=postgresql+asyncpg://postgres:bristi%402410@localhost:5432/walletai

# Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Set to true once you add a real Gemini key above
USE_REAL_AI=false

# JWT secret – used to sign auth tokens (keep this private)
SECRET_KEY=walletai-super-secret-jwt-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS – must be a plain comma-separated string (no brackets/quotes)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,null

# App
APP_ENV=development
DEBUG=true
